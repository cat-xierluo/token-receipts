{
  "name": "token-receipts",
  "version": "2.0.2",
  "description": "Thermal-receipt style usage reports for AI coding sessions (Claude Code, OpenAI Codex CLI). Multi-model pricing, dual currency, BLE thermal printing.",
  "license": "MIT",
  "author": "Chris Hutchinson <github.com/chrishutchinson>",
  "contributors": [
    "maoking <github.com/cat-xierluo>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cat-xierluo/token-receipts.git"
  },
  "bugs": {
    "url": "https://github.com/cat-xierluo/token-receipts/issues"
  },
  "homepage": "https://github.com/cat-xierluo/token-receipts#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "token-receipts": "bin/token-receipts.js"
  },
  "files": [
    "dist",
    "bin"
