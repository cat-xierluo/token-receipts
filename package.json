  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "ccusage": "^18.0.5",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.3",
    "mxw01-thermal-printer": "0.1.0",
    "ora": "^9.1.0",
    "prompts": "^2.4.2",
    "qrcode": "1.5.4",
    "usb": "^2.17.0"
  },
